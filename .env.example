# Keep actual credentials only in your local .env. Never paste them into chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=photo_editortest_bot
OPENAI_API_KEY=
IMAGE_PROVIDER=mock
IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
IMAGE_QUALITY=medium
DATA_DIR=data
ENABLE_DEMO_CREDITS=true
# Three real generations once per consenting Telegram user. OpenAI mode only; billing disabled.
ENABLE_TRIAL_ACCESS=false
SUPPORT_CONTACT=
STUDIO_ENABLED=true
STUDIO_PORT=8089
# Set only after the studio has an HTTPS address; localhost preview needs no public URL.
MINI_APP_URL=
# External checkout only. No Stars are implemented; Telegram digital-goods restriction remains.
BILLING_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/payment-result
BILLING_ADMIN_TOKEN=
# A required explicitly configured tax regime for receipts, not a tax recommendation.
YOOKASSA_VAT_CODE=1
RECEIPT_EMAIL=
