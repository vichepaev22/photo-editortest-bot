    },
    "square": {
      "width": 1080,
      "height": 1080
    },
    "wide": {
      "width": 1600,
      "height": 900
    }
  },
  "function_visuals": {
    "hair": "same portrait, several hairstyles",
    "glasses": "same portrait, 2-3 frames",
    "clothes": "same adult, two outfits",
    "background": "same portrait, changed surroundings",
    "enhance": "small before/after detail",
    "merge": "two photo cards become one composition",
    "reference": "small reference and large adapted portrait",
    "document": "one portrait becomes a 2x2 sheet of four identical photos"
  },
  "motion": {
    "scene_seconds": [
      3,
      4
    ],
    "transition_seconds": [
      0.4,
      0.7
    ],
    "easing": "smooth ease-in-out",
    "background_motion": "subtle, almost still on result",
    "sound_required": false
  },
  "carousel_example": [
    "Один снимок. Разные образы.",
    "Загрузите своё фото",
