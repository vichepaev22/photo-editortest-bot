    "poster": "motion/welcome/out/obraz-welcome-poster.webp",
    "scene": "motion/welcome/src/Scene.tsx",
    "art": "motion/welcome/src/art.tsx"
  },
  "visual_language": {
    "style": "adult editorial 2D illustration",
    "mood": [
      "calm",
      "friendly",
      "clear"
    ],
    "background": "warm off-white",
    "character_consistency": "same adult face and pose inside each transformation story"
  },
  "palette": {
    "background": "#F6F5F3",
    "card": "#FFFFFF",
    "text": "#29343B",
    "accent": "#176B5B",
