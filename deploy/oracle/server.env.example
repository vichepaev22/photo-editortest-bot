# Actual secrets belong in /etc/image-studio-bot.env (root:root, mode 0600).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=photo_editortest_bot
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
IMAGE_QUALITY=medium
DATA_DIR=/var/lib/image-studio-bot/live-pilot
ENABLE_DEMO_CREDITS=false
ENABLE_TRIAL_ACCESS=true
BILLING_ENABLED=false
SUPPORT_CONTACT=
STUDIO_ENABLED=true
STUDIO_PORT=8089
MINI_APP_URL=https://vichepaev22.github.io/photo-editortest-bot/
# Windows localhost proxies cannot be reused on this VM.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost
