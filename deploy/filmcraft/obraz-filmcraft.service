[Unit]
Description=Obraz isolated Filmcraft media worker (owner-only Telegram pilot)
After=local-fs.target

[Service]
Type=simple
User=obraz-filmcraft
Group=obraz-filmcraft
WorkingDirectory=/var/lib/obraz-filmcraft
Environment=PYTHONPATH=/opt/image-studio-bot/app/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/obraz-filmcraft
Environment=RAYON_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStartPre=/opt/obraz-filmcraft/engine/filmcraft-cli --version
ExecStart=/opt/image-studio-bot/app/.venv/bin/python -m image_studio.filmcraft_engine --spool /var/lib/obraz-filmcraft --engine /opt/obraz-filmcraft/engine/filmcraft-cli
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0007
Nice=10
CPUQuota=100%
MemoryHigh=448M
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
OOMPolicy=kill
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/obraz-filmcraft
InaccessiblePaths=/etc/image-studio-bot.env /var/lib/image-studio-bot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
